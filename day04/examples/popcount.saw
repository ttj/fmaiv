// SAW script: prove the C popcount_loop implementation in popcount.c agrees
// with the Cryptol popcount_simple specification on every 8-bit input.
//
// Run:
//      clang -c -emit-llvm -O0 -o popcount.bc popcount.c
//      saw popcount.saw
//
// Expected output (last line): "Proof succeeded! popcount_loop".
//
// Why only popcount_loop, and not also popcount_kernighan?
// -------------------------------------------------------
// `popcount_loop` has a fixed `for (i = 0; i < 8; ++i)` loop — SAW unrolls
// it once and discharges the equivalence in milliseconds.
//
// `popcount_kernighan` has a data-dependent `while (x != 0)` loop. SAW's
// symbolic executor needs an explicit unroll bound for those, otherwise
// it tries to explore arbitrarily many iterations and never terminates.
// On the Cryptol side we *already* show the two definitions agree
// (`:prove popcount_kernighan_eq` → Q.E.D.), so the chain
//
//      popcount_loop (C)  ==  popcount_simple (Cryptol)   <-- this SAW script
//      popcount_simple (Cryptol)  ==  popcount_kernighan (Cryptol)  <-- :prove
//
// proves all three are equivalent without the SAW heroics.

// Big picture: SAW loads the COMPILED C (as LLVM bitcode), then proves the C
// function computes the SAME result as a Cryptol expression for EVERY input.

// Pull in the Cryptol specs (popcount_simple, etc.) so we can refer to them.
import "popcount.cry";

// Load the compiled C into a module handle `m`. (`<-` binds the result to a
// name in SAWScript, much like `=`.) popcount.bc is the bitcode you built with
// `clang -c -emit-llvm -O0 -o popcount.bc popcount.c`.
m <- llvm_load_module "popcount.bc";

// A small helper so we don't repeat the proof boilerplate. It takes the name of
// a C function and a Cryptol `impl` expression, and proves they match.
let popcount_spec name impl = do {
  // `llvm_verify m name [] false (...) z3` = "prove that C function `name` in
  // module m meets the spec in (...), using no helper lemmas ([]), no extra
  // path-sat checking (false), discharged by the z3 solver."
  llvm_verify m name [] false (do {
    // `llvm_fresh_var "x" (llvm_int 8)` makes a SYMBOLIC input named x: an
    // 8-bit value standing for ALL possible bytes at once (not one concrete number).
    x <- llvm_fresh_var "x" (llvm_int 8);
    // Call the C function with that symbolic input. `llvm_term x` hands the
    // symbolic value to the function as its argument.
    llvm_execute_func [llvm_term x];
    // State the EXPECTED return value: whatever the Cryptol `impl x` computes.
    // The `{{ ... }}` brackets switch into Cryptol; `impl x` applies the spec.
    // SAW then proves the C return equals this for every x.
    llvm_return (llvm_term {{ impl x }});
  }) z3;
};

// C `popcount_loop` returns uint8_t (= [8]). Cryptol `popcount_simple`
// returns [4]. Pad with four zero MSBs to match the C return type.
// Here `impl` is an ANONYMOUS Cryptol function: `\(x : [8]) -> ...` means
// "given an 8-bit x, produce ...". The body `(zero : [4]) # popcount_simple x`
// uses `#` (concatenate) to glue four zero bits in front of the [4] count,
// WIDENING it to [8] so its type lines up with the C function's [8] return.
// Without this pad, [4] != [8] and the proof would be a type mismatch.
popcount_loop_ov <- popcount_spec "popcount_loop"
  {{ \(x : [8]) -> (zero : [4]) # popcount_simple x }};

print "popcount_loop verified against popcount_simple.";
